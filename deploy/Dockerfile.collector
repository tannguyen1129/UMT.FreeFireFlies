FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY nest-cli.json tsconfig*.json ./
COPY apps/aqi-service ./apps/aqi-service
COPY config ./config
RUN npx nest build research-collector

FROM node:20-alpine AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist/apps/aqi-service/research-collector.main.js ./dist/apps/research-collector/main.js
COPY --from=builder /app/config ./config

RUN mkdir -p /app/uploads \
    && chown -R node:node /app

USER node

CMD ["node", "dist/apps/research-collector/main.js"]
