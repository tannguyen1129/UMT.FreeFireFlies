# Copy this file to deploy/.env and replace every placeholder before deployment.
POSTGRES_DB=green_aqi_research
POSTGRES_USER=green_aqi
POSTGRES_PASSWORD=replace-with-a-long-random-password

OWM_API_KEY=replace-with-openweathermap-api-key
# Research collector (intervals are constrained to 10-60 minutes).
AQ_COLLECTION_INTERVAL_MINUTES=15
WEATHER_COLLECTION_INTERVAL_MINUTES=15
COLLECTOR_REQUEST_TIMEOUT_MS=10000
COLLECTOR_MAX_RETRIES=3
COLLECTOR_CONCURRENCY=2
COLLECTOR_BATCH_DELAY_MS=1000
